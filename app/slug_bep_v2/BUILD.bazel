load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@slug_crates//:defs.bzl", "crate_edition")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "slug_bep_v2",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
)

rust_test(
    name = "bep_test",
    srcs = ["tests/bep.rs"],
    edition = crate_edition(),
    size = "small",
    visibility = ["//visibility:private"],
    deps = [":slug_bep_v2"],
)
