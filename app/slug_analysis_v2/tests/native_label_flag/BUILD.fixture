load(":defs.bzl", "leaf", "probe", "select_probe", "tool_probe")
package(default_visibility = ["//visibility:public"])
leaf(name = "a", value = "A")
leaf(name = "b", value = "B")
leaf(name = "test_leaf", value = "test", testonly = True, visibility = ["//visibility:private"])
label_flag(name = "flag", build_setting_default = ":a", help = "label forwarding")
native.label_flag(name = "second", build_setting_default = ":a")
label_flag(name = "universal", build_setting_default = ":a", scope = "universal")
label_flag(name = "source", build_setting_default = "implicit.txt")
label_flag(name = "private_test", build_setting_default = ":test_leaf")
label_flag(name = "unused_missing", build_setting_default = ":missing")
alias(name = "alias", actual = ":flag")
alias(name = "alias2", actual = ":alias")
alias(name = "value_alias", actual = ":a")
probe(name = "probe", dep = ":alias2")
tool_probe(name = "tool", dep = ":flag")
config_setting(name = "relative", flag_values = {":flag": ":a"})
config_setting(name = "canonical", flag_values = {":alias2": "//:a"})
config_setting(name = "specific", values = {"compilation_mode": "fastbuild"}, flag_values = {":alias2": "//:a"})
config_setting(name = "duplicate", flag_values = {":flag": ":a", ":second": ":a"})
config_setting(name = "invalid", flag_values = {":flag": "//bad/...:x"})
select_probe(name = "selected", value = select({":relative": "base", ":specific": "specific"}))
select_probe(name = "duplicate_probe", value = select({":duplicate": "bad"}))
select_probe(name = "invalid_probe", value = select({":invalid": "bad"}))
