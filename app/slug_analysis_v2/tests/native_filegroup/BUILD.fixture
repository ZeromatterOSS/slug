load(':defs.bzl', 'origin', 'observe', 'consume', 'private_macro', 'predeclared')
exports_files(['a.txt','b.txt','c.txt','d.txt','default.txt','data.txt','validation.txt'])
filegroup(name='empty')
filegroup(name='single',srcs=['a.txt'])
filegroup(name='implicit',srcs=['implicit.txt'])
filegroup(name='duplicates',srcs=[':single','a.txt'])
filegroup(name='left',srcs=[':single','b.txt'])
filegroup(name='right',srcs=[':single','c.txt'])
filegroup(name='diamond',srcs=[':left',':right'])
alias(name='alias',actual=':duplicates',visibility=['//visibility:public'])
origin(name='generated',generated=True)
filegroup(name='generated_group',srcs=[':generated'])
alias(name='generated_alias',actual=':generated_group')
origin(name='topo',srcs=['a.txt','b.txt'],order='topological')
origin(name='child',srcs=['c.txt'])
origin(name='pre',srcs=['a.txt'],deps=[':child'],order='preorder')
filegroup(name='mixed',srcs=[':topo',':pre'])
origin(name='runfiles_origin',srcs=['a.txt'],default_files=['default.txt'],data_files=['data.txt'],validation=['validation.txt'])
filegroup(name='runfiles',srcs=[':runfiles_origin'])
filegroup(name='nested_runfiles',srcs=[':runfiles'])
observe(name='source_observer',dep=':diamond',single=':alias',tool=':alias',exec_single=':alias',exec_tool=':alias')
observe(name='generated_observer',dep=':generated_alias',single=':generated_alias',tool=':generated_alias',exec_single=':generated_alias',exec_tool=':generated_alias')
consume(name='source_consumer',dep=':source_observer')
consume(name='generated_consumer',dep=':generated_observer')
observe(name='zero_tool',dep=':empty',single=':single',tool=':empty',exec_single=':single',exec_tool=':single')
observe(name='multi_tool',dep=':diamond',single=':single',tool=':diamond',exec_single=':single',exec_tool=':single')
config_setting(name='opt',values={'compilation_mode':'opt'})
config_setting(name='dbg',values={'compilation_mode':'dbg'})
filegroup(name='selected',srcs=select({':opt':['missing.txt'],'//conditions:default':['a.txt']}))
filegroup(name='switch',srcs=select({':opt':['b.txt'],'//conditions:default':['a.txt']}))
filegroup(name='no_match',srcs=select({':opt':['a.txt'],':dbg':['b.txt']}))
filegroup(name='bad_condition',srcs=select({':single':['a.txt']}))
filegroup(name='cycle_a',srcs=[':cycle_b'])
filegroup(name='cycle_b',srcs=[':cycle_a'])
filegroup(name='private_cross',srcs=['//other:private'])
filegroup(name='public_cross',srcs=['//other:public_alias'])
private_macro(name='macro_private')
filegroup(name='with_data',srcs=['a.txt'],data=['data.txt'])
filegroup(name='with_group',srcs=['a.txt'],output_group='extra')
package_group(name='package_group_input',packages=['//...'])
alias(name='package_group_alias',actual=':package_group_input')
filegroup(name='from_package_group',srcs=[':package_group_input'])
filegroup(name='from_package_group_alias',srcs=[':package_group_alias'])
origin(name='testonly_origin',srcs=['a.txt'],testonly=True)
filegroup(name='from_testonly_origin',srcs=[':testonly_origin'])
alias(name='testonly_alias',actual='a.txt',testonly=True)
filegroup(name='from_testonly_alias',srcs=[':testonly_alias'])
alias(name='hidden_testonly_alias',actual=':testonly_origin')
alias(name='hidden_testonly_chain',actual=':hidden_testonly_alias')
filegroup(name='from_hidden_testonly',srcs=[':hidden_testonly_chain'])
predeclared(name='testonly_generator',out='testonly_generated.txt',testonly=True)
filegroup(name='from_testonly_generated',srcs=[':testonly_generated.txt'])
