        "use std::borrow::Cow;\nuse std::fmt;\n"
      ],
      [
        "    fn path(&self) -> String {\n        self.artifact.path().into_owned()\n    }\n\n    fn basename(&self) -> String {\n        self.path().rsplit('/').next().unwrap().to_owned()\n    }\n",
