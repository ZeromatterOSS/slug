  "base_revision": "3acc580c7",
  "verdict": "ACCEPT_BOUNDED_GENERAL_REPOSITORY_FILESYSTEM_MUTATIONS",
  "observable_capability": "Actual repository-rule Starlark performs Archive/Delete operations against one command-owned physical tree and branches on actual deletion Booleans. Original configured Rust cquery advances beyond real http_archive cleanup to Rust allocator analysis and missing runtime Label().",
  "compatibility": {
    "exact": "Admitted Bazel9 archive and Linux deletion semantics on writable generated regular-file/directory trees; exact actual Boolean and ordered replay.",
    "slug_native": "Structural semantic identity, combined128 operations/command; delete131072 visited entries,4MiB cumulative path work/invocation,depth256,no refunds;4MiB+64KiB scoped frontier envelope; unchanged verified archive/decoder/manifest caps.",
    "unsupported_deferred": "Root/external deletion, nonnormalized string forms, symlink mixtures, non-Linux/inaccessible directories, archive-produced unknown path observations and both directions of execute/filesystem composition. Existing repository execute/callback/Args/toolchain adapters remain replacement-required."
  },
  "architecture": "Single tagged RepositoryFilesystemOperation/Result with one owner/ordinal/combined call index, exact preceding effect prefix, epoch/nonce, active scope and terminal realization. Core takes prefix before I/O; failure drops it and publishes no record/root. Delete-only source routes require same physical terminal seal. No new cache or locking; existing source certificates and immutable materializer retained.",
  "source": {
    "bazel_revision": "8220c6198837d5c13d53fea211cf3282aa12408a",
    "anchors": [
      "StarlarkRepositoryContext.java373\u2013405 delete String/StarlarkPath, recursive tree and actual bool",
      "FileSystem.java265 no-follow directory semantics",
      "tools/build_defs/repo/utils.bzl223 actual upstream cleanup consumer",
      "UnixFileSystem.java422/unix_jni.cc742/813 inaccessible-directory behavior explicitly excluded; generated dirs currently writable"
    ]
  },
