build --bes_results_url=https://app.buildbuddy.io/invocation/
build --bes_backend=grpcs://remote.buildbuddy.io
common --remote_cache=grpcs://remote.buildbuddy.io
common --remote_timeout=10m
common --remote_executor=grpcs://remote.buildbuddy.io
common --spawn_strategy=worker,sandboxed,local
build:buildbuddy-cache --remote_executor=
build:buildbuddy-cache --remote_cache_async=false
build:buildbuddy-rbe --spawn_strategy=remote
build:buildbuddy-rbe --noremote_local_fallback
build:buildbuddy-rbe --remote_default_exec_properties=OSFamily=linux
build:buildbuddy-rbe --remote_default_exec_properties=Arch=amd64
build:buildbuddy-rbe --remote_default_exec_properties=use-self-hosted-executors=false
