config_setting(name = "linux", values = {"cpu": "k8"})
config_setting(name = "arm", values = {"cpu": "arm"})

exports_files([
    "BUILD.bazel",
    "source.txt",
    "default.txt",
    "implicit.txt",
    "branch_linux.txt",
    "branch_arm.txt",
    "branch_default.txt",
    "shared.txt",
])

probe_rule(
    name = "explicit",
    one = ":source.txt",
    many = [":source.txt", "//other:cross.txt"],
)

probe_rule(name = "omitted")
probe_rule(name = "empty", many = [])
probe_rule(name = "implicit")
context_rule(
    name = "package_context",
    one = "bare.txt",
    many = ["dir/bare.txt", ":colon.txt", "//other:cross.txt"],
)
filegroup(name = "filegroup_srcs_omitted")
filegroup(name = "filegroup_srcs_explicit_empty", srcs = [])
probe_rule(
    name = "selecting",
    chosen = select({
        ":linux": [":branch_linux.txt"],
        ":arm": [":branch_arm.txt"],
        "//conditions:default": [":branch_default.txt"],
    }),
    combined = [":shared.txt"] + select({
        ":linux": [":branch_linux.txt", ":shared.txt"],
        ":arm": [":branch_arm.txt"],
        "//conditions:default": [":branch_default.txt", ":shared.txt"],
    }),
)
output_rule(name = "outputs", out = "one.out", outs = ["two.out", "three.out"])
output_rule(name = "outputs_two", out = "four.out", outs = ["five.out", "six.out"])
probe_rule(
    name = "dicts",
    string_labels = {"first": ":source.txt", "cross": "//other:cross.txt"},
    label_strings = {":default.txt": "default", "//other:cross.txt": "cross"},
    label_lists = {"local": [":implicit.txt", ":source.txt"], "cross": ["//other:cross.txt"]},
)
alias(name = "alias", actual = ":explicit")
probe_rule(name = "missing_ref", many = ["//does_not_exist:nope"])

F	0644	1041	9921cf3f34e97433a47786f83044a8cebd10e5d7d2e0315137f44fddd60cd739	query-labels-attribute-metadata/pkg/defs.bzl
def _impl(ctx):
    return [DefaultInfo()]

probe_rule = rule(
    implementation = _impl,
    attrs = {
        "one": attr.label(),
        "many": attr.label_list(),
        "with_default": attr.label_list(default = [":default.txt"]),
        "note": attr.string(default = "plain-text"),
        "_implicit": attr.label(default = ":implicit.txt"),
        "chosen": attr.label_list(),
        "combined": attr.label_list(),
        "string_labels": attr.string_keyed_label_dict(),
        "label_strings": attr.label_keyed_string_dict(),
        "label_lists": attr.label_list_dict(),
    },
)

context_rule = rule(
    implementation = _impl,
    attrs = {
        "one": attr.label(mandatory = True),
        "many": attr.label_list(mandatory = True),
    },
)

output_rule = rule(
    implementation = _impl,
    attrs = {
        "out": attr.output(mandatory = True),
        "outs": attr.output_list(mandatory = True),
    },
)

must_rule = rule(
    implementation = _impl,
    attrs = {"required": attr.label(mandatory = True)},
)

