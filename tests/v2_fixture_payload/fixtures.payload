F	0644	1966	b727af77115a68c70ebece1e48451eeb1f16805575f752826fd7233546435e61	query-attr-observable-candidates/attr/defs.bzl
def _impl(ctx):
    return []

def _test_impl(ctx):
    return []

def _output_impl(ctx):
    return []

def _transition_impl(settings, attr):
    return {}

identity_transition = transition(
    implementation = _transition_impl,
    inputs = [],
    outputs = ["//attr:base_string_setting"],
)

normal_rule = rule(
    implementation = _impl,
    attrs = {
        "empty_string": attr.string(),
        "empty_label_list": attr.label_list(),
        "empty_string_keyed_label_dict": attr.string_keyed_label_dict(),
        "nullable_label": attr.label(default = None, allow_single_file = True),
        "_private": attr.string(default = "secret"),
        "args": attr.string_list(),
        "string_dict": attr.string_dict(),
        "string_keyed_label_dict": attr.string_keyed_label_dict(),
        "label_keyed_string_dict": attr.label_keyed_string_dict(),
        "label_list_dict": attr.string_list_dict(),
        "scalar_label": attr.label(),
        "equal_select_string": attr.string(),
        "cross_select_string": attr.string(),
        "string_concat": attr.string(),
        "selector_key": attr.string(),
    },
)

normal_private_other = rule(
    implementation = _impl,
    attrs = {"_private": attr.string(default = "other")},
)

transition_rule = rule(
    implementation = _impl,
    cfg = identity_transition,
)

exec_rule = rule(
    implementation = _impl,
    executable = True,
)

probe_test = rule(
    implementation = _test_impl,
    test = True,
)

string_setting = rule(
    implementation = _impl,
    build_setting = config.string(flag = True),
)

output_rule = rule(
    implementation = _output_impl,
    attrs = {"nullable_output": attr.output()},
)

def legacy_macro(name, target_name = None, native_filegroup = False, **kwargs):
    if target_name == None:
        target_name = name
    if native_filegroup:
        native.filegroup(name = target_name, **kwargs)
    else:
        normal_rule(name = target_name, **kwargs)

