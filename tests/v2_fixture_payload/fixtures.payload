D	0755	query-path-topology
F	0644	2250	659dc2e21a6d64c68bffc411c91da932470e24e33f3a4dfeec8eb7c966c87a3f	query-path-topology/BUILD.bazel
load(":defs.bzl", "edge")

# A unique three-node/two-edge rule path.
filegroup(name = "linear_start", srcs = [":linear_mid"])
filegroup(name = "linear_mid", srcs = [":linear_end"])
filegroup(name = "linear_end")

# A diamond: somepath may legally choose either complete shortest branch.
filegroup(name = "diamond_start", srcs = [":diamond_split"])
filegroup(name = "diamond_split", srcs = [":diamond_left", ":diamond_right"])
filegroup(name = "diamond_left", srcs = [":diamond_end"])
filegroup(name = "diamond_right", srcs = [":diamond_end"])
filegroup(name = "diamond_end")

# A cycle with an escape edge to its destination.
filegroup(name = "cycle_a", srcs = [":cycle_b"])
filegroup(name = "cycle_b", srcs = [":cycle_a", ":cycle_end"])
filegroup(name = "cycle_end")

filegroup(name = "disconnected")

# Multiple reachable origin/destination pairs.
filegroup(name = "multi_a", srcs = [":multi_end_a"])
filegroup(name = "multi_b", srcs = [":multi_end_b"])
filegroup(name = "multi_end_a")
filegroup(name = "multi_end_b")

# Exactly one reachable pair among these operands.
filegroup(name = "one_pair_origin", srcs = [":one_pair_destination"])
filegroup(name = "one_pair_other_origin")
filegroup(name = "one_pair_destination")
filegroup(name = "one_pair_other_destination")

# Two genuinely ambiguous origin/destination pairs, with no shared root.
filegroup(name = "ambiguous_a", srcs = [":ambiguous_a_left", ":ambiguous_a_right"])
filegroup(name = "ambiguous_a_left", srcs = [":ambiguous_a_end"])
filegroup(name = "ambiguous_a_right", srcs = [":ambiguous_a_end"])
filegroup(name = "ambiguous_a_end")
filegroup(name = "ambiguous_b", srcs = [":ambiguous_b_left", ":ambiguous_b_right"])
filegroup(name = "ambiguous_b_left", srcs = [":ambiguous_b_end"])
filegroup(name = "ambiguous_b_right", srcs = [":ambiguous_b_end"])
filegroup(name = "ambiguous_b_end")

alias(name = "alias_start", actual = ":linear_start")

# A Starlark-defined label-list edge, without analysis or generated outputs.
edge(name = "custom_start", deps = [":custom_mid"])
edge(name = "custom_mid", deps = [":custom_end"])
edge(name = "custom_end")

# Source-file endpoint direction is deliberately one-way in the loading graph.
filegroup(name = "source_parent", srcs = ["source.txt"])

