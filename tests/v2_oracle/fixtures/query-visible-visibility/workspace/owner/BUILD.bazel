package(default_visibility = ["//visibility:private"])

package_group(
    name = "exact",
    packages = ["//viewer"],
)

package_group(
    name = "subtree",
    packages = ["//viewer/..."],
)

package_group(
    name = "base",
    packages = [
        "//viewer/...",
        "-//viewer/blocked/...",
    ],
)

package_group(
    name = "reallow",
    packages = ["//viewer/blocked/reallowed"],
)

package_group(
    name = "middle",
    includes = [
        ":base",
        ":reallow",
    ],
)

package_group(
    name = "top",
    includes = [":middle"],
)

package_group(
    name = "cycle_a",
    packages = ["//viewer"],
    includes = [":cycle_b"],
)

package_group(
    name = "cycle_b",
    includes = [":cycle_a"],
)

filegroup(
    name = "explicit_public",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "explicit_private",
    visibility = ["//visibility:private"],
)

filegroup(name = "default_private")

filegroup(
    name = "viewer_pkg",
    visibility = ["//viewer:__pkg__"],
)

filegroup(
    name = "viewer_subpackages",
    visibility = ["//viewer:__subpackages__"],
)

filegroup(
    name = "other_subpackages",
    visibility = ["//other:__subpackages__"],
)

filegroup(
    name = "direct_specs",
    visibility = [
        "//viewer:__pkg__",
        "//viewer:__subpackages__",
    ],
)

filegroup(
    name = "direct_subpackages_only",
    visibility = ["//viewer:__subpackages__"],
)

filegroup(
    name = "exact_only",
    visibility = [":exact"],
)

filegroup(
    name = "subtree_only",
    visibility = [":subtree"],
)

filegroup(
    name = "base_only",
    visibility = [":base"],
)

filegroup(
    name = "top_reallow",
    visibility = [":top"],
)

filegroup(
    name = "direct_reallow",
    visibility = [
        ":base",
        "//viewer/blocked:__subpackages__",
    ],
)

filegroup(
    name = "cycle_visible",
    visibility = [":cycle_a"],
)

filegroup(name = "ordinary")

filegroup(
    name = "wrong_direct",
    visibility = [":ordinary"],
)

package_group(
    name = "wrong_include",
    includes = [":ordinary"],
)

filegroup(
    name = "wrong_include_target",
    visibility = [":wrong_include"],
)
