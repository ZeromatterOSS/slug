load("//:defs.bzl", "oracle_test")

oracle_test(name = "nested_unfiltered_test")
test_suite(
    name = "nested_unfiltered",
    tests = [":nested_unfiltered_test"],
)
test_suite(
    name = "parent_requires_parent_tag",
    tests = [":nested_unfiltered"],
    tags = ["parent_only"],
)

oracle_test(name = "shared_blocked_test", tags = ["blocked"])
test_suite(
    name = "shared_unfiltered_nested",
    tests = [":shared_blocked_test"],
)
test_suite(
    name = "filtered_direct_then_nested",
    tests = [":shared_blocked_test", ":shared_unfiltered_nested"],
    tags = ["-blocked"],
)

oracle_test(name = "literal_plus_tag_test", tags = ["+tag"])
oracle_test(name = "plain_tag_test", tags = ["tag"])
test_suite(
    name = "exclude_literal_plus_tag",
    tests = [":literal_plus_tag_test", ":plain_tag_test"],
    tags = ["-+tag"],
)
