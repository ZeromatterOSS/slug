module(
    name = "rules_rust_073_toolchain_owner",
    version = "0.1.0",
)

bazel_dep(
    name = "rules_rust",
    version = "0.73.0",
)
bazel_dep(
    name = "platforms",
    version = "1.1.0",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["nightly/2025-09-14"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
