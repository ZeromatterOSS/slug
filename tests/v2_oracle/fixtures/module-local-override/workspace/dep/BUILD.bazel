exports_files(["target.txt"])
filegroup(name = "files", srcs = ["target.txt", "missing_input.txt"])
alias(name = "files_alias", actual = ":files")
config_setting(name = "is_k8", values = {"cpu": "k8"})
test_suite(name = "suite_omitted")
test_suite(name = "suite_empty", tests = [], tags = ["manual", "a"])
test_suite(name = "suite_parent", tests = [":suite_empty"])
test_suite(name = "suite_cycle_a", tests = [":suite_cycle_b"])
test_suite(name = "suite_cycle_b", tests = [":suite_cycle_a"])
package_group(name = "pg_empty")
package_group(name = "pg_nonempty", packages = ["//pkg", "//tree/...", "-//blocked", "-//blocked_tree/...", "public", "private"])
package_group(name = "pg_leaf", packages = ["//leaf"])
package_group(name = "pg_parent", includes = [":pg_leaf"])
package_group(name = "pg_cycle_a", includes = [":pg_cycle_b"])
package_group(name = "pg_cycle_b", includes = [":pg_cycle_a"])
